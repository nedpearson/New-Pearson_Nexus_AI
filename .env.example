# Root env example (monorepo)
# - For Vite apps, env files are typically read from the app directory (e.g. apps/web/.env).
# - Keep values here as the canonical names, then copy into the app you deploy.

# ---- Supabase (frontend / Vite) ----
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: if you use OAuth providers in Supabase Auth
# Set these in Supabase Dashboard → Authentication → URL Configuration:
# - Site URL: https://YOUR-RAILWAY-DOMAIN
# - Additional Redirect URLs: https://YOUR-RAILWAY-DOMAIN/**
# (and add your localhost URL(s) for development if needed)

# ---- Supabase (server) ----
# Only needed if/when you add an API/worker that uses the service role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---- Offline Sync (server) ----
# If set, POST /api/sync requires Authorization: Bearer <SYNC_SHARED_SECRET>
# (Set this as a Railway variable; do not expose it to the browser.)
SYNC_SHARED_SECRET=YOUR_LONG_RANDOM_SECRET

# ---- Document Intelligence (Azure) ----
AZURE_DI_ENDPOINT=https://YOUR_RESOURCE_NAME.cognitiveservices.azure.com
AZURE_DI_KEY=YOUR_AZURE_DOCUMENT_INTELLIGENCE_KEY
# Optional override (defaults to prebuilt-document)
AZURE_DI_MODEL_ID=prebuilt-document

# ---- Speech-to-Text (Deepgram) ----
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY
DEEPGRAM_MODEL=nova-2
DEEPGRAM_LANGUAGE=en

# ---- Superagent feature flags (server) ----
# When enabled, /upload/mobile and /upload/voice use the src/superagent pipeline.
SUPERAGENT_DOCS_ENABLED=true
SUPERAGENT_VOICE_ENABLED=true
# Provider selection (defaults to "null" for safety)
SUPERAGENT_DOCS_PROVIDER=null   # set to "azure" to use Azure DI adapter
SUPERAGENT_VOICE_PROVIDER=null  # set to "deepgram" to use Deepgram adapter

# ---- Canonical persistence (recommended) ----
# If set, ingestions are upserted into Supabase table `pnx_ingestions` (unique on hash).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# If set, original artifacts + JSON are uploaded to this Supabase Storage bucket.
SUPABASE_STORAGE_BUCKET=ingestion

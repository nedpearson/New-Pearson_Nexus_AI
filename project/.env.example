# Remote Integrations Master Switch (default: disabled for offline stability)
VITE_ENABLE_REMOTE_INTEGRATIONS=false

# Backend Configuration
# Auth backend selection:
# - local  : 100% offline, uses localStorage/sessionStorage
# - server : cookie-based auth via /api/auth (httpOnly cookies + refresh rotation)
VITE_AUTH_BACKEND=local

# Data Store Configuration
# Set to 'local' for localStorage (default, fully offline)
# Set to 'supabase' for Supabase (not yet implemented, falls back to local)
VITE_DATASTORE=local
